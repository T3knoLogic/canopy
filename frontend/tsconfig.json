{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@bonsai-os-sdk": ["../../shared/bonsai-os-sdk/index.ts"],
      "@bonsai-theme": ["../../shared/bonsai-theme/index.ts"]
    }
  },
  "include": ["src", "../../shared/bonsai-os-sdk/**/*.ts", "../../shared/bonsai-theme/**/*.ts"]
}
